{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arizanerede",
  "main": "src/edge-entry.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "arizanerede.com", "custom_domain": true },
    { "pattern": "www.arizanerede.com", "custom_domain": true }
  ],
  "vars": {
    "GA_MEASUREMENT_ID": "G-CEBVEYWRRK",
    "CLARITY_PROJECT_ID": "y723n09w80"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
